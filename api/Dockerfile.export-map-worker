# export_map_worker — slim image (no GDAL/rasterio/geopandas/STAC stack).
# Playwright + Chromium dominate size; base is still far smaller than ghcr.io/osgeo/gdal:ubuntu-full.
#
# Build: docker build -f Dockerfile.export-map-worker -t prism-export-map-worker .
#
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/

WORKDIR /

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      ca-certificates \
      curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-export-map-worker.txt /
RUN pip install --no-cache-dir --upgrade 'pip>=26.1.2' 'setuptools>=82.0.0' 'wheel>=0.46.2' 'jaraco.context>=6.1.0' \
    && pip install --no-cache-dir -r /requirements-export-map-worker.txt \
    && pip install --no-cache-dir --upgrade 'setuptools>=82.0.0' 'wheel>=0.46.2'

# Security updates + trim packages not needed for headless Chromium (Xvfb/Xorg CVE noise,
# dev headers, optional GStreamer "bad" codecs). Before Playwright so autoremove cannot
# strip browser runtime libraries.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get -y upgrade \
    && DEBIAN_FRONTEND=noninteractive apt-get purge -y \
         linux-libc-dev \
         gstreamer1.0-plugins-bad libgstreamer-plugins-bad1.0-0 \
         xvfb xserver-common \
    && DEBIAN_FRONTEND=noninteractive apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Browser + OS deps (same pattern as main api/Dockerfile)
RUN playwright install chromium \
    && playwright install-deps chromium \
    && pip install --no-cache-dir --upgrade 'setuptools>=82.0.0' 'msgpack>=1.2.1' \
    && rm -rf /root/.cache/ms-playwright/.links \
    && python -c "from playwright.sync_api import sync_playwright; p = sync_playwright().start(); b = p.chromium.launch(args=['--no-sandbox', '--disable-dev-shm-usage']); b.close(); p.stop()"

# Distro python3-* from install-deps + ensurepip bundled wheels: Trivy still reports
# setuptools 70.3.0 / msgpack 1.1.2 next to the patched pip copies.
RUN apt-get purge -y python3-setuptools python3-pkg-resources python3-msgpack 2>/dev/null || true \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/* \
 && find /usr -path '*ensurepip/_bundled/setuptools*.whl' -delete \
 && pip install --no-cache-dir --upgrade 'setuptools>=82.0.0' 'msgpack>=1.2.1'

COPY ./prism_app /prism_app

WORKDIR /prism_app/
