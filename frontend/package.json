  "_resolutionsNotes": {
    "node-notifier": "Build compatibility — keep (native notify stack).",
    "canvas": "Stub via link: — skip native canvas install.",
    "glob": "CVE-2025-64756 / GHSA-23c5-xmqv-rm74 — force glob 13 (babel-jest still pulls 7.x).",
    "js-yaml": "CVE-2025-64718 — flatten eslint/babel-jest 3.x to 4.x. Lock 4.1.1 (alerting prod path needs 4.3.1).",
    "@isaacs/brace-expansion": "glob 13 / minimatch 10 scoped fork. Pin >=5.0.1 so Yarn v1 does not flatten onto unscoped v2.",
    "**/glob/minimatch": "CVE-2026-45149 — rimraf>glob: minimatch >=10.2.5.",
    "**/glob/minimatch/brace-expansion": "CVE-2026-69152 / GHSA-rgw5-rvv9-x895 — brace-expansion >=5.0.9 (5.0.8 maxLength bypass).",
    "diff": "Force >=5.2.2 (jsdiff). Vite/jest transitive; lock 8.0.3.",
    "string-width": "Force CommonJS v4 (glob>jackspeak>cliui, cypress>listr2). Drop when parents ship ESM-safe range.",
    "form-data": "CVE-2025-7783 / GHSA-fjxv-7rqg-78g4 — >=3.0.4.",
    "@babel/helpers": "GHSA-968p-4wvh-cqc8 — >=7.26.10.",
    "systeminformation": "CVE-2025-68154 / GHSA-wphj-fx3q-84ch — cypress transitive, >=5.27.14.",
    "qs": "CVE-2025-15284 / GHSA-6rw7-vpxm-498p — cypress>@cypress/request, >=6.14.1.",
    "lodash": "GHSA-r5fr-rjxr-66jc / GHSA-f23m-r3pf-42rh (CVE-2026-4800 / CVE-2026-2950) — >=4.18.0.",
    "dompurify": "DOM XSS sanitizer. Pin ^3.4.13.",
    "protocol-buffers-schema": "CVE-2026-5758 / GHSA-j452-xhg8-qg39 — geotiff transitive, >=3.6.1.",
    "protobufjs": "CVE-2026-45740 + CVE-2026-54269 — posthog-js>@opentelemetry/otlp-transformer, >=7.6.3.",
    "_picomatch": "CVE-2026-33671 / CVE-2026-33672 — lock-only: 2.x at 2.3.2+, 4.x separate (flat resolution cannot merge majors).",
    "_yaml": "CVE-2026-33532 — lock-only: yaml 1.x (husky>cosmiconfig) + 2.x (lint-staged); cannot flatten."
  },
  "_comment": "The 'defaults' and 'not ie 11' are needed to avoid build issues with maplibre-gl.",
