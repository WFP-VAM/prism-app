{
  "name": "prism-alerting",
  "version": "0.0.1",
  "description": "",
  "engines": {
    "node": ">=20.6.0",
    "npm": "10"
  },
  "author": "",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "glob": "^13.0.6",
    "js-yaml": "^4.3.1",
    "@isaacs/brace-expansion": ">=5.0.1",
    "**/filelist/minimatch/brace-expansion": "^2.1.4",
    "ws": "^8.21.0",
    "string-width": "4.2.3",
    "form-data": "^3.0.4",
    "lodash": "^4.18.0",
    "basic-ftp": "^5.3.1",
    "**/filelist/minimatch": "^5.1.9"
  },
  "_resolutionsNotes": {
    "glob": "CVE-2025-64756 — force 13.x (direct glob is still 11 for jest). Review when jest allows 13.",
    "js-yaml": "CVE-2025-64718 + CVE-2026-59869 / GHSA-52cp-r559-cp3m + GHSA-5p4m-2wfm-xmqj — puppeteer>cosmiconfig, >=4.3.1.",
    "@isaacs/brace-expansion": "glob 13 scoped fork. Pin >=5.0.1 so Yarn v1 does not flatten onto unscoped v2.",
    "**/filelist/minimatch/brace-expansion": "CVE-2026-69152 / GHSA-rgw5-rvv9-x895 — ejs>jake>filelist>minimatch still v2; >=2.1.4.",
    "ws": "GHSA-58qx-3vcg-4xpx / CVE-2026-45736 + GHSA-96hv-2xvq-fx4p / CVE-2026-48779 — puppeteer-core, >=8.21.0.",
    "string-width": "Force CommonJS v4 (glob>jackspeak>cliui). Drop when parents ship ESM-safe range.",
    "form-data": "CVE-2025-7783 / GHSA-fjxv-7rqg-78g4 — >=3.0.4.",
    "lodash": "GHSA-r5fr-rjxr-66jc / GHSA-f23m-r3pf-42rh (CVE-2026-4800 / CVE-2026-2950) — >=4.18.0.",
    "basic-ftp": "GHSA-5rq4-664w-9x2c + GHSA-6v7q-wjvx-w8wg + GHSA-rpmf-866q-6p89 — puppeteer>get-uri, >=5.3.1.",
    "**/filelist/minimatch": "GHSA-23c5-xmqv-rm74 + GHSA-3ppc-4f35-3m26 + GHSA-7r86-cg39-jmmj — ejs>jake>filelist, minimatch >=5.1.9.",
    "_brace-expansion": "5.x still lock-only (^5.0.2 → 5.0.5, rimraf/dev). Yarn v1 cannot pin 2.x and 5.x with one resolution; 2.x is **/filelist/minimatch/brace-expansion."
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test,scripts}/**/*.{ts,js}\" --max-warnings 0 --fix",
    "setup:common": "sh -c \"rimraf ./node_modules/prism-common && cd ../common && yarn install && yarn build\" && sh -c \"yarn install --check-files\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "alert-worker": "yarn ts-node src/alert-worker.ts",
    "aa-storm-alert-worker": "yarn ts-node src/aa-storm-alert-runner.ts",
    "aa-flood-alert-worker": "yarn ts-node src/aa-flood-alert-runner.ts",
    "docker-alert": "source ../api/set_envs.sh && docker compose run --entrypoint 'yarn alert-worker' alerting-node",
    "check-alerts-db-contract": "ts-node src/ci/check-alerts-db-contract.ts",
    "smoke-alerts-db-pool": "ts-node src/ci/smoke-alerts-db-pool.ts",
    "smoke-alerting-workers": "ts-node src/ci/smoke-alerting-workers.ts",
    "audit": "node ../scripts/yarn-audit-summary.js",
    "audit:preflight": "yarn install --frozen-lockfile && yarn run audit"
  },
  "dependencies": {
    "@turf/bbox": "^6.3.0",
    "bluebird": "^3.7.2",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "geojson": "^0.5.0",
    "jpeg-js": "^0.4.4",
    "lodash": "^4.18.0",
    "node-fetch": "^2.6.7",
    "nodemailer": "^9.0.1",
    "pg": "^8.5.1",
    "prism-common": "file:../common",
    "puppeteer": "^24.33.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/jest": "^30.0.0",
    "@types/node": "20.14.8",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "audit-ci": "^7.1.0",
    "eslint": "^8.57.1",
    "faker": "^4.1.0",
    "glob": "^11.1.0",
    "jest": "^30.2.0",
    "rimraf": "^6.1.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^6.2.1",
    "ts-node": "^8.10.2",
    "tsconfig-paths": "^3.9.0",
    "typescript": "5.9.3",
    "yargs": "^15.4.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": [
      ".spec.ts$",
      ".test.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
